PORT=5000
NODE_ENV=development

# Use DATABASE_URL in hosted environments, or the individual values below locally.
# DATABASE_URL=postgresql://user:password@host:5432/carbon_tracker
PGHOST=127.0.0.1
PGPORT=5000
PGDATABASE=carbon_tracker
PGUSER=postgres
PGPASSWORD=@dm!n

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default admin created by db/seed.js
SEED_ADMIN_EMAIL=admin@carbontracker.com
SEED_ADMIN_PASSWORD=Admin@12345
